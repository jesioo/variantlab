    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "jsdom": "^31.0.0",
    "publint": "^0.3.25",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsdown": "^0.23.7",
    "typescript": "catalog:",
    "vitest": "^5.1.0"
