{
  "name": "variantlab",
  "version": "0.0.0",
  "description": "Switch between variants of a React component live in the browser.",
  "keywords": [
    "react",
    "variants",
    "design",
    "prototyping",
    "devtools"
  ],
  "license": "MIT",
  "author": "Grzegorz Kazulak",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jesioo/variantlab.git",
    "directory": "packages/variantlab"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
